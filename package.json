{
  "name": "avdragsfrikalkulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run css-types && vite",
    "build": "npm run css-types && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run css-types && vitest run",
    "css-types": "tcm src --pattern \"**/*.module.css\" --allowArbitraryExtensions --silent",
    "css-types:watch": "tcm src --pattern \"**/*.module.css\" --allowArbitraryExtensions --watch"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typed-css-modules": "^0.9.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
